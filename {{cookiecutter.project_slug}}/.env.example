# Copy to .env for local development:  cp .env.example .env
# Every variable the project reads is listed here. Never commit a real .env.

# --- Core --------------------------------------------------------------------
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_NAME={{ cookiecutter.project_name }}
BASE_URL=http://localhost:8000

# --- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{ cookiecutter.project_slug }}

# --- Private files ------------------------------------------------------------
# Personal data never has a permanent URL: page links go through the permission
# gate at /files/, and every signed link expires after this many seconds. Do not
# go above 3600 without a written reason.
PRIVATE_URL_EXPIRY_SECONDS=3600
PRIVATE_FILE_LINKS_ENABLED=True
{%- if cookiecutter.media_storage == "filesystem" %}
# Blank: Django streams private files. Set to /protected-private/ once nginx has
# the matching internal location (docs/03-infrastructure.md), so nginx sends them.
PRIVATE_FILES_ACCEL_PREFIX=
{%- endif %}
{%- if cookiecutter.media_storage != "filesystem" %}

# --- Media storage ------------------------------------------------------------
# Media lives in an object store. TWO storages in separate buckets: editorial
# media, and personal data (CVs, ID copies, form attachments) whose every URL is
# signed and expires. Neither bucket/container may be
# public-read - see docs/03-infrastructure.md for the policy to apply.
MEDIA_LOCATION=media
PRIVATE_MEDIA_LOCATION=private
{%- if cookiecutter.static_storage == "cloud" %}
# The only prefix that is granted public read.
STATIC_LOCATION=static
{%- endif %}
{%- if cookiecutter.media_storage == "s3" %}

AWS_STORAGE_BUCKET_NAME=
# The private bucket: public access blocked, no CDN, versioned. Required, and it
# must differ from the bucket above (core.E010).
AWS_PRIVATE_BUCKET_NAME=
AWS_S3_REGION_NAME=me-south-1
# Never set these on AWS: the server's instance role (or IRSA) provides temporary
# credentials. Keys are for an S3-compatible store (MinIO, Spaces, Wasabi) only.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Only for an S3-compatible store (MinIO, DigitalOcean Spaces, Wasabi).
# AWS_S3_ENDPOINT_URL=
# "virtual" (default, what AWS requires); "path" for a store that needs it.
# AWS_S3_ADDRESSING_STYLE=virtual
# CDN in front of the PUBLIC prefix. Never used for private media.
# AWS_S3_CUSTOM_DOMAIN=
# Lifetime of a signed URL for public editorial media, in seconds.
AWS_QUERYSTRING_EXPIRE=3600
{%- if cookiecutter.static_storage == "cloud" %}
# Optional: static files in a bucket of their own, keeping the public-read grant
# physically away from the private data. Defaults to the bucket above, where a
# bucket policy scoped to the static prefix does the same job.
# AWS_STATIC_BUCKET_NAME=
{%- endif %}
{%- elif cookiecutter.media_storage == "gcs" %}

GS_BUCKET_NAME=
# The private bucket: no public grant, no CDN, versioned. Required, and it must
# differ from the bucket above (core.E010).
GS_PRIVATE_BUCKET_NAME=
GS_PROJECT_ID=
# Path to a service-account key file. Leave unset on a host using workload
# identity or the metadata server - preferred, because there is then no key file
# to rotate, leak or commit.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/{{ cookiecutter.project_slug }}/gcs.json
# Lifetime of a signed URL for public editorial media, in seconds.
GS_EXPIRATION_SECONDS=3600
# Only for a GCS emulator or a private service endpoint.
# GS_CUSTOM_ENDPOINT=
{%- if cookiecutter.static_storage == "cloud" %}
# Static files need a bucket of their own on GCS: IAM is per bucket and uniform
# bucket-level access disables object ACLs, so a public prefix inside a private
# bucket cannot be expressed. Set this to a bucket granted allUsers objectViewer.
GS_STATIC_BUCKET_NAME=
{%- endif %}
{%- else %}

AZURE_ACCOUNT_NAME=
AZURE_CONTAINER=
# The private container: no anonymous access, no CDN. Public access is a
# per-container setting in Azure, so this is what makes "private" structural.
# Required, and it must differ from the container above (core.E010).
AZURE_PRIVATE_CONTAINER=
# Leave unset on a host using a managed identity - preferred, because there is
# then no long-lived key to rotate, leak or commit.
# AZURE_ACCOUNT_KEY=
# AZURE_CONNECTION_STRING=
# CDN in front of the PUBLIC container. Never used for private media.
# AZURE_CUSTOM_DOMAIN=
# Lifetime of the SAS on a public editorial media URL, in seconds.
AZURE_URL_EXPIRATION_SECS=3600
{%- if cookiecutter.static_storage == "cloud" %}
# Static files need a container of their own: public access is a per-container
# setting in Azure with no per-object override. Set this to the one container
# whose public access level is "Blob".
AZURE_STATIC_CONTAINER=
{%- endif %}
{%- endif %}
{%- endif %}
{%- if cookiecutter.asset_pipeline == "compressor" %}

# --- Asset pipeline -----------------------------------------------------------
# Off in development so a CSS edit is visible on reload without a compile step.
# Production forces it on, together with COMPRESS_OFFLINE.
COMPRESS_ENABLED=False
{%- endif %}
{%- if cookiecutter.cache == "redis" %}

# --- Cache --------------------------------------------------------------------
# Required in production: rate limit and throttle counters live here, and a
# per-process cache multiplies every limit by the number of workers.
REDIS_URL=redis://127.0.0.1:6379/1
{%- endif %}

{%- if cookiecutter.task_queue == "huey" %}

# --- Background tasks ----------------------------------------------------------
# One consumer process runs both the queue and the periodic schedule
# ('make worker'). It must be restarted by every deploy, or it keeps running the
# code it started with - see docs/07-deployment.md.
#
# True = run tasks inline in the calling process, with no consumer at all. Defaults
# to DEBUG, so development needs no worker. Set it to False when you want to test
# the real thing locally, and leave it unset in production.
# HUEY_IMMEDIATE=False
HUEY_WORKERS=2
{%- if cookiecutter.huey_backend == "postgres" %}
# The queue lives in DATABASE_URL's database, in tables 'manage.py migrate' creates.
# There is nothing else to configure and no second service to run.
{%- elif cookiecutter.huey_backend == "redis" %}
# A different Redis database from the cache on purpose: flushing the cache must not
# be able to empty the queue.
HUEY_REDIS_URL=redis://127.0.0.1:6379/2
{%- else %}
# Single-process storage. Development only - see docs/14-decisions.md.
# HUEY_SQLITE_PATH=huey.sqlite3
{%- endif %}
# How long audit-log entries are kept before the scheduled prune deletes them.
# The security baseline floor is 365; below that the job refuses to run.
AUDITLOG_RETENTION_DAYS=400
{%- elif cookiecutter.task_queue == "celery" %}

# --- Background tasks ----------------------------------------------------------
# TWO processes besides the web application: a worker ('make worker') and exactly
# one beat ('make beat'). Both must be restarted by every deploy, or they keep
# running the code they started with - see docs/07-deployment.md.
{%- if cookiecutter.task_broker == "redis" %}
# A different Redis database from the cache on purpose: flushing the cache must not
# be able to empty the queue.
CELERY_BROKER_URL=redis://127.0.0.1:6379/3
{%- elif cookiecutter.task_broker == "rabbitmq" %}
CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5672//
{%- else %}
# Production uses SQS with no credentials in the URL: boto3 resolves them from the
# instance role. Locally, point this at the Redis in docker-compose instead - the
# broker differs by environment on purpose, and docs/03-infrastructure.md records
# what must be re-tested on UAT because of it.
CELERY_BROKER_URL=redis://127.0.0.1:6379/3
# CELERY_BROKER_URL=sqs://
AWS_SQS_REGION=me-south-1
# MUST exceed CELERY_TASK_TIME_LIMIT. SQS redelivers a message once this expires,
# whether or not the task is still running, so a slow task would run twice.
AWS_SQS_VISIBILITY_TIMEOUT=3600
AWS_SQS_QUEUE_PREFIX={{ cookiecutter.project_slug }}-
# Naming the queue outright lets the IAM policy drop ListQueues and GetQueueUrl.
# AWS_SQS_QUEUE_URL=
{%- endif %}
CELERY_TASK_DEFAULT_QUEUE={{ cookiecutter.project_slug }}
# No result backend by default: nothing waits on a task's return value, and a result
# store is another datastore to size and expire.
# CELERY_RESULT_BACKEND=
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360
# Where beat records what it last ran. Must be writable and must PERSIST across
# deploys: delete it and every periodic task fires at once on the next start.
# CELERY_BEAT_SCHEDULE_FILENAME=/var/lib/{{ cookiecutter.project_slug }}/celerybeat-schedule
# True = run tasks inline in the calling process. Useful locally; in a deployed
# environment it means the worker is idle and the schedule never runs.
CELERY_TASK_ALWAYS_EAGER=False
# How long audit-log entries are kept before the scheduled prune deletes them.
# The security baseline floor is 365; below that the job refuses to run.
AUDITLOG_RETENTION_DAYS=400
{%- endif %}

# --- E-mail -------------------------------------------------------------------
# Either a single URL, or the discrete variables below. Unset = console backend.
# EMAIL_URL=smtp://user:password@smtp.example.com:587
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL={{ cookiecutter.author_email }}
DEFAULT_ADMIN_EMAIL={{ cookiecutter.author_email }}
{%- if cookiecutter.spam_protection == "turnstile_honeypot" %}

# --- Spam protection (Cloudflare Turnstile) -----------------------------------
# Unset = honeypot only, so development and CI are never blocked. Production
# without a key is a go-live finding.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
{%- endif %}
{%- if cookiecutter.rate_limiting == "yes" %}

# --- Rate limiting ------------------------------------------------------------
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=0.5
# Number of trusted proxies in front of the app. Wrong value = every request
# appears to come from the load balancer and one attacker locks out everyone.
AXES_IPWARE_PROXY_COUNT=0
{%- endif %}
{%- if cookiecutter.api != "none" %}

# --- API ----------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Separate signing key so rotating it does not invalidate sessions. Defaults to
# SECRET_KEY when unset.
# JWT_SIGNING_KEY=
THROTTLE_ANON=60/min
THROTTLE_USER=600/hour
THROTTLE_AUTH=10/min
THROTTLE_WRITE=60/hour
# Base URI for the 'type' member of RFC 9457 problem responses.
# API_PROBLEM_BASE_URL=
# Outbound integration. Unset = the client refuses to construct, with a
# clear error, instead of failing at call time.
# INTEGRATION_BASE_URL=
# INTEGRATION_USERNAME=
# INTEGRATION_PASSWORD=
# INTEGRATION_TIMEOUT_CONNECT=5.0
# INTEGRATION_TIMEOUT_READ=20.0
# INTEGRATION_FORCE_TLS12=False
# Schema UI: on in development and staging, off in production.
API_DOCS_ENABLED=True
{%- endif %}
{%- if cookiecutter.analytics == "ga4_gtm" %}

# --- Analytics ----------------------------------------------------------------
# Leave empty outside production so staging traffic never reaches the client's
# analytics property.
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
{%- endif %}
{%- if cookiecutter.sentry == "yes" %}

# --- Error monitoring ---------------------------------------------------------
# Unset = Sentry fully disabled: no init, no network calls.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE={{ cookiecutter.project_slug }}@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=False
{%- endif %}
{%- if cookiecutter.countries_app != "none" %}

# --- Countries ----------------------------------------------------------------
{%- if cookiecutter.countries_app == "cities" %}
# ISO 3166-1 alpha-2 codes withheld from public country dropdowns. Read only by
# Country.objects.selectable(), which every country list on the site goes through.
{%- else %}
# ISO 3166-1 alpha-2 codes withheld from public country dropdowns. Normally empty:
# the KUWAITNET django-countries fork applies the country-list policy to the data
# it ships, so this is only for a per-client exclusion on top of that.
{%- endif %}
# COUNTRY_EXCLUDED_CODES=
{%- endif %}

# --- Search engine indexing ---------------------------------------------------
# Defaults to True, so robots.txt serves "Disallow: /". A new environment fails
# CLOSED: staging and UAT are never accidentally indexed. Production must set this
# to False explicitly - it is a signed item on the go-live checklist.
ROBOTS_DISALLOW_ALL=True

# --- Administration paths -----------------------------------------------------
{%- if cookiecutter.stack == "wagtail" %}
# Two independent prefixes. Never /admin/, and never make one a path under the
# other: knowing one must not give away the second login form.
WAGTAIL_ADMIN_URL_PREFIX={{ cookiecutter.admin_url_prefix }}
DJANGO_ADMIN_URL_PREFIX={{ cookiecutter.django_admin_url_prefix }}
{%- else %}
# Never /admin/: it is the first path every automated scanner tries.
DJANGO_ADMIN_URL_PREFIX={{ cookiecutter.admin_url_prefix }}
{%- endif %}

# --- Production only ----------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# CSRF_TRUSTED_ORIGINS=https://{{ cookiecutter.domain_name }}
{%- if cookiecutter.media_storage == "filesystem" %}
# MEDIA_ROOT=/var/www/{{ cookiecutter.project_slug }}/media
# PRIVATE_MEDIA_ROOT=/var/www/{{ cookiecutter.project_slug }}/private-media
{%- endif %}
LOG_LEVEL=INFO
